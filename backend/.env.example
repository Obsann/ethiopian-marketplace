# Backend environment — copy to .env and fill in values
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ethiopian_marketplace?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Chapa test/sandbox secret from Dashboard → Settings → API Keys with Test mode ON.
# Dashboard keys start with CHASECK_TEST- (hyphen). Some docs show CHASECK_TEST_.
# Must NOT contain "xxx" (that placeholder uses in-app mock checkout).
# Never put this key in web/. Do not use a live CHASECK- key until you are ready.
CHAPA_SECRET_KEY="CHASECK_TEST_xxx"
# Dashboard webhook secret. HMAC of the raw body (x-chapa-signature / chapa-signature).
# Webhook URL in the dashboard: https://<public-host>/api/payments/verify
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret"
# Chapa GETs this after payment. localhost is not reachable from Chapa — use ngrok/https for callbacks.
# Local testing still works via return_url → /payments/return → POST /api/payments/sync.
CHAPA_CALLBACK_URL="http://localhost:4000/api/payments/callback"
# Browser origin of the Next.js app (no trailing slash). Local: http://localhost:3000.
# On Render: set to the Vercel production URL (e.g. https://suqet.vercel.app) for CORS + redirects.
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated extra CORS origins (Vercel preview URLs). Not used for redirects.
# CORS_ORIGINS="https://suqet-git-main-team.vercel.app,https://suqet-abc123.vercel.app"
# Public origin of this API (no trailing slash). Used for local listing image URLs when Cloudinary is unset.
# On Render: https://suqet-api.onrender.com
BACKEND_PUBLIC_URL="http://localhost:4000"
# Google OAuth (optional). Create a Web client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
# Optional SMTP for password-reset and verification emails. Without it, local/dev returns the link in the API.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (STARTTLS) or 465 (SSL), and a Google App Password (not your login).
# SMTP_FROM must be that same Gmail address (not noreply@localhost). Leave empty to use SMTP_USER.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Set true when the API sits behind nginx / a load balancer / Render so rate limits use the real IP.
# On Render: TRUST_PROXY=true and NODE_ENV=production (etm_sid cookie: Secure + SameSite=None for Vercel↔Render).
TRUST_PROXY="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
